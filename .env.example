# FedSanitize Auth — copy to .env and fill in for anything beyond local dev.
# Never commit the real .env file.

# --- Required in staging/production ---
# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FEDSANITIZE_SECRET_KEY=

# --- Admin bootstrap ---
FEDSANITIZE_ADMIN_USERNAME=admin
# Leave blank in local dev to get a random password printed once at startup.
FEDSANITIZE_ADMIN_PASSWORD=

# --- JWT tuning (defaults shown) ---
FEDSANITIZE_JWT_ALG=HS256
FEDSANITIZE_ACCESS_TOKEN_EXPIRE_MINUTES=30
FEDSANITIZE_REFRESH_TOKEN_EXPIRE_DAYS=7
FEDSANITIZE_JWT_ISSUER=fedsanitize-api

# --- Login rate limiting (defaults shown) ---
FEDSANITIZE_LOGIN_RATE_LIMIT_ATTEMPTS=5
FEDSANITIZE_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- Optional: seed demo edge-client credentials at startup ---
# Comma-separated client ids matching the simulation roster, e.g.:
FEDSANITIZE_SEED_CLIENT_IDS=C0,C1,C2,C3,C4,C5,C6,C7,C8,C9

FEDSANITIZE_ENV=development
